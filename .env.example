# Copy to .env.local and fill in. Never commit .env.local.

# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered (defaults to profile.email in lib/data.ts).
CONTACT_TO_EMAIL=you@example.com

# Sender. Must use a domain verified in Resend (https://resend.com/domains).
# For quick testing, "onboarding@resend.dev" works but can only deliver to your own Resend account email.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# --- Optional hardening -------------------------------------------------

# Shared rate limit across serverless instances (https://upstash.com — free tier is plenty).
# Without these, a small in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile).
# Set BOTH to enable the check; leave empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Send the visitor a short "got your message" email. Off by default (it mails an address
# the visitor typed) — pair with Turnstile if you enable it.
CONTACT_AUTOREPLY=false

# Canonical URL for Open Graph / sitemap / robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
