# Copy to .env.local and fill in. Never commit .env.local.

# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered (defaults to profile.email in lib/data.ts).
CONTACT_TO_EMAIL=you@example.com

# Sender. Must use a domain verified in Resend (https://resend.com/domains).
# For quick testing, "onboarding@resend.dev" works but can only deliver to your own Resend account email.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
